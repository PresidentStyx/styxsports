{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "styxsports",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "sports.styxam.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
