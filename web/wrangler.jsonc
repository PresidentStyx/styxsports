{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "styxsports",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application", "run_worker_first": true
  },
  "routes": [
    { "pattern": "sports.styxam.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE", "class_name": "Presence" },
      { "name": "POOL", "class_name": "Pool" },
      { "name": "GAMES", "class_name": "Games" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Presence"] },
    { "tag": "v2", "new_sqlite_classes": ["Pool"] },
    { "tag": "v3", "new_sqlite_classes": ["Games"] }
  ]
}
