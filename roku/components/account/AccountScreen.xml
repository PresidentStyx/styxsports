<?xml version="1.0" encoding="utf-8"?>
<!--
  Premium account, laid out like AccountActivity (1 dp = 2 px): a row padded 72x40 dp, centred
  vertically; left column = wordmark, title, lead, steps, status, buttons; right = the 340 dp code
  card (label, big gold code, countdown, QR on white, scan hint). Signed in, the card is hidden.
-->
<component name="AccountScreen" extends="Group">
  <interface>
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="resumed" type="boolean" alwaysNotify="true" />
    <field id="start" type="boolean" alwaysNotify="true" onChange="onStart" />
    <field id="devKey" type="string" alwaysNotify="true" onChange="onDevKey" />
  </interface>
  <script type="text/brightscript" uri="AccountScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0A0A0AFF" />

    <!-- left column: x 144, width fills up to the card -->
    <Group id="left" translation="[144,0]">
      <Poster id="wordmark" width="392" height="60" uri="pkg:/images/wordmark.png" />
      <Label id="title" text="Premium account" />
      <Label id="lead" wrap="true" lineSpacing="5" />
      <Label id="steps" wrap="true" lineSpacing="15" />
      <Label id="statusText" wrap="true" />
      <Group id="buttons" />
    </Group>

    <!-- code card: 340 dp wide, right-aligned to the 72 dp padding -->
    <Group id="card" translation="[1096,0]">
      <Poster id="cardBg" uri="pkg:/images/ui/panel.9.png" width="680" />
      <Label id="codeLabel" text="YOUR CODE" width="560" horizAlign="center" />
      <Label id="code" width="560" horizAlign="center" text="--- ---" />
      <Label id="countdown" width="560" horizAlign="center" />
      <Rectangle id="qrFrame" width="400" height="400" color="0xFFFFFFFF" />
      <Poster id="qr" width="368" height="368" loadDisplayMode="scaleToFit" />
      <Label id="scan" width="560" horizAlign="center" text="Scan with your phone camera" />
    </Group>

    <Timer id="pollTimer" duration="3" />
    <Timer id="tickTimer" repeat="true" duration="1" />
    <Timer id="layoutTimer" repeat="false" duration="0.05" />
    <Timer id="closeTimer" repeat="false" duration="1.6" />
  </children>
</component>
