<?xml version="1.0" encoding="utf-8"?>
<!--
  MarkupGrid item: one channel, laid out like LiveTvActivity.ChannelAdapter (1 dp = 2 px): a
  259x224 px card (surface, 1 dp outline, 12 dp corners) padded 12/12/12/10 dp with the logo
  (full width, 44 dp tall, fit-centred) over the name (13 sp, centred, up to two lines). The
  grid's white 3 dp focus ring is drawn on top while the grid has focus.
-->
<component name="ChannelCell" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
    <field id="gridHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="ChannelCell.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/ui/card.9.png" width="259" height="224" />
    <Poster id="logo" translation="[24,24]" width="211" height="88" loadDisplayMode="scaleToFit" />
    <Poster id="placeholder" uri="pkg:/images/ui/crest_placeholder.png" translation="[91,30]" width="76" height="76" visible="false" />
    <Label id="name" translation="[24,128]" width="211" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" />
    <Poster id="ring" uri="pkg:/images/ui/ring.9.png" width="259" height="224" visible="false" />
  </children>
</component>
