<?xml version="1.0" encoding="utf-8"?>
<!--
  Home, laid out exactly like HomeActivity on Android TV (1 dp = 2 px at 1080p):
    top bar   y 0..126   wordmark 196x30 dp, status text, Refresh / Sign in buttons, version
    chips     y 130..184 sport filter chips (54 px), scrolled to keep the focused one centred
    rows      y 192..    a vertical scroller (16 px top pad) of rows: header (title + muted subtitle)
                         and a horizontal strip of 584x300 cards, the focused card centred.
  Rows and strips are plain Groups moved by animations, so focus, spacing and fonts can match the
  Android views one for one (RowList imposes its own).
-->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="resumed" type="boolean" alwaysNotify="true" onChange="onResumed" />
    <field id="start" type="boolean" alwaysNotify="true" onChange="onStart" />
    <field id="devKey" type="string" alwaysNotify="true" onChange="onDevKey" />
  </interface>
  <script type="text/brightscript" uri="HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Pool.brs" />
  <script type="text/brightscript" uri="pkg:/source/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <!-- rows scroller (drawn first so the chrome above covers anything scrolled under it) -->
    <Group id="scroller" translation="[0,192]" clippingRect="[0,0,1920,888]">
      <Group id="rowsGroup" translation="[0,16]" />
    </Group>
    <Rectangle id="chromeBg" width="1920" height="192" color="0x0A0A0AFF" />

    <!-- top bar: padding 48/22/48/10 dp, children centred on y = 75 -->
    <Poster id="wordmark" translation="[96,45]" width="392" height="60" uri="pkg:/images/wordmark.png" />
    <Label id="status" translation="[488,60]" width="600" height="30" horizAlign="right" vertAlign="center" />
    <Group id="topButtons" translation="[1824,44]" />
    <Label id="version" translation="[1824,63]" height="26" vertAlign="center" />

    <!-- chips -->
    <Group id="chipsRow" translation="[0,130]">
      <Group id="chips" translation="[96,0]" />
    </Group>

    <!-- loading / problem overlay (HomeActivity.buildOverlay) -->
    <Group id="overlay" visible="false">
      <Rectangle width="1920" height="1080" color="0x0A0A0AFF" />
      <Poster id="overlayLogo" width="600" height="92" uri="pkg:/images/wordmark.png" translation="[660,394]" />
      <BusySpinner id="spinner" translation="[924,542]" />
      <Label id="overlayMessage" translation="[96,650]" width="1728" horizAlign="center" wrap="true" />
      <Group id="overlayButtons" translation="[0,720]" />
    </Group>

    <Animation id="rowsAnim" duration="0.25" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="rowsInterp" fieldToInterp="rowsGroup.translation" key="[0,1]" keyValue="[[0,16],[0,16]]" />
    </Animation>
    <Animation id="chipsAnim" duration="0.25" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="chipsInterp" fieldToInterp="chips.translation" key="[0,1]" keyValue="[[96,0],[96,0]]" />
    </Animation>

    <Timer id="statusTimer" repeat="true" duration="30" />
    <Timer id="fullTimer" repeat="true" duration="600" />
    <Timer id="layoutTimer" repeat="false" duration="0.05" />
  </children>
</component>
