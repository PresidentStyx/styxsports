<?xml version="1.0" encoding="utf-8"?>
<!-- RowList item: one game. 440 x 250. -->
<component name="EventCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="rowHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="EventCard.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <Rectangle id="ring" translation="[-4,-4]" width="448" height="218" color="0x00000000" />
    <Rectangle id="bg" width="440" height="210" color="0x161616FF" />
    <Rectangle id="stripe" width="6" height="210" color="0x00000000" />

    <Rectangle id="whenBg" translation="[22,14]" width="90" height="32" color="0x2A2A2AFF" />
    <Label id="when" translation="[22,14]" width="90" height="32" font="font:SmallBoldSystemFont" color="0xF2F2F2FF" horizAlign="center" vertAlign="center" />
    <Label id="league" translation="[126,14]" width="200" height="32" font="font:SmallestSystemFont" color="0x9A9A9AFF" vertAlign="center" />
    <Label id="tag" translation="[330,14]" width="88" height="32" font="font:SmallestBoldSystemFont" color="0xF5C518FF" horizAlign="right" vertAlign="center" />

    <Poster id="crestHome" translation="[22,60]" width="56" height="56" loadDisplayMode="scaleToFit" />
    <Label id="home" translation="[92,56]" width="326" height="64" font="font:MediumBoldSystemFont" color="0xF2F2F2FF" vertAlign="center" wrap="false" maxLines="1" />
    <Poster id="crestAway" translation="[22,130]" width="56" height="56" loadDisplayMode="scaleToFit" />
    <Label id="away" translation="[92,126]" width="326" height="64" font="font:MediumBoldSystemFont" color="0xF2F2F2FF" vertAlign="center" wrap="false" maxLines="1" />

    <Label id="score" translation="[262,56]" width="156" height="134" font="font:MediumBoldSystemFont" color="0xF2F2F2FF" horizAlign="right" vertAlign="center" />
    <Label id="star" translation="[388,176]" width="40" height="30" font="font:SmallBoldSystemFont" color="0xF5C518FF" horizAlign="right" vertAlign="center" />
  </children>
</component>
