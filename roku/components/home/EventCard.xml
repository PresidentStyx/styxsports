<?xml version="1.0" encoding="utf-8"?>
<!--
  One game card, laid out like HomeActivity.createCard() on Android TV (1 dp = 2 px):
  292x150 dp card with 12 dp corners; status pill top-left, badges top-right; two team columns
  (38 dp crest over the name) around a bold score / "vs"; the league along the bottom.
  Focus swaps the background for the white-ringed one and scales the card to 1.06.
-->
<component name="EventCard" extends="Group">
  <interface>
    <field id="content" type="node" onChange="onContent" />
    <field id="focused" type="boolean" onChange="onFocus" />
    <field id="relayout" type="boolean" alwaysNotify="true" onChange="onRelayout" />
  </interface>
  <script type="text/brightscript" uri="EventCard.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <Group id="card" scaleRotateCenter="[292,150]">
      <Poster id="bg" uri="pkg:/images/ui/card.9.png" width="584" height="300" />

      <!-- top line -->
      <Poster id="pillBg" uri="pkg:/images/ui/pill_time.9.png" translation="[28,24]" height="38" />
      <Label id="pill" translation="[28,24]" height="38" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
      <Group id="badges" translation="[556,24]">
        <Poster id="starIcon" uri="pkg:/images/ui/star.png" />
        <Poster id="flameIcon" uri="pkg:/images/ui/flame.png" />
        <Label id="hotText" height="38" vertAlign="center" />
        <Poster id="premIcon" uri="pkg:/images/ui/star.png" />
        <Label id="premText" height="38" vertAlign="center" />
      </Group>

      <!-- middle -->
      <Poster id="crestHome" width="76" height="76" loadDisplayMode="scaleToFit"
              loadingBitmapUri="pkg:/images/ui/crest_placeholder.png" failedBitmapUri="pkg:/images/ui/crest_placeholder.png" />
      <Label id="home" width="196" horizAlign="center" wrap="true" maxLines="2" />
      <Label id="middle" width="136" height="40" horizAlign="center" vertAlign="center" />
      <Poster id="crestAway" width="76" height="76" loadDisplayMode="scaleToFit"
              loadingBitmapUri="pkg:/images/ui/crest_placeholder.png" failedBitmapUri="pkg:/images/ui/crest_placeholder.png" />
      <Label id="away" width="196" horizAlign="center" wrap="true" maxLines="2" />
      <Label id="single" translation="[28,62]" width="528" horizAlign="center" wrap="true" maxLines="3" />

      <!-- bottom -->
      <Label id="league" translation="[28,254]" width="528" height="26" vertAlign="center" />
    </Group>
    <Animation id="scaleAnim" duration="0.12" easeFunction="linear">
      <Vector2DFieldInterpolator id="scaleInterp" fieldToInterp="card.scale" key="[0,1]" keyValue="[[1,1],[1.06,1.06]]" />
    </Animation>
  </children>
</component>
