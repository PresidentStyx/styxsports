<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen player. Two modes:
    - game:    `event` (+ `base`) - resolves the stream page's servers, plays HLS, Left/Right switch server
    - channel: `channelGroup` + `channelIndex` - plays IPTV channels, Left/Right zap within the group
-->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="resumed" type="boolean" alwaysNotify="true" onChange="onResumed" />
    <field id="start" type="boolean" alwaysNotify="true" onChange="onStart" />
    <field id="devKey" type="string" alwaysNotify="true" onChange="onDevKey" />
    <field id="event" type="assocarray" />
    <field id="base" type="string" />
    <field id="channelGroup" type="assocarray" />
    <field id="channelIndex" type="integer" value="-1" />
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <Rectangle id="black" width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" enableTrickPlay="false" />

    <!-- HUD (bottom) -->
    <Group id="hud">
      <Rectangle translation="[0,840]" width="1920" height="240" color="0x000000A0" />
      <Rectangle id="hudPillBg" translation="[72,890]" width="90" height="40" color="0xE53935FF" />
      <Label id="hudPill" translation="[72,890]" width="90" height="40" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />
      <Label id="hudTitle" translation="[72,940]" width="1400" height="60" font="font:LargeBoldSystemFont" color="0xF2F2F2FF" vertAlign="center" />
      <Label id="hudScore" translation="[1500,890]" width="348" height="110" font="font:LargeBoldSystemFont" color="0xF2F2F2FF" horizAlign="right" vertAlign="center" />
      <Label id="hudServer" translation="[72,1004]" width="1000" height="34" font="font:SmallSystemFont" color="0x9A9A9AFF" vertAlign="center" />
      <Label id="hudHint" translation="[900,1004]" width="948" height="34" font="font:SmallestSystemFont" color="0x9A9A9AFF" horizAlign="right" vertAlign="center" />
    </Group>

    <!-- loading -->
    <Group id="loading">
      <Label id="loadingText" translation="[0,500]" width="1920" height="80" font="font:MediumSystemFont" color="0xF2F2F2FF" horizAlign="center" vertAlign="center" />
    </Group>

    <!-- status panel -->
    <Group id="panel" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000C0" />
      <Rectangle translation="[460,300]" width="1000" height="480" color="0x161616FF" />
      <Label id="panelTitle" translation="[500,330]" width="920" height="60" font="font:LargeBoldSystemFont" color="0xF2F2F2FF" vertAlign="center" />
      <Label id="panelText" translation="[500,400]" width="920" height="220" font="font:MediumSystemFont" color="0xC8C8C8FF" wrap="true" lineSpacing="6" />
      <Group id="panelButtons" translation="[500,680]" />
    </Group>

    <Timer id="hudTimer" duration="4" />
    <Timer id="retryTimer" duration="1.5" />
    <Timer id="scoreTimer" repeat="true" duration="30" />
  </children>
</component>
