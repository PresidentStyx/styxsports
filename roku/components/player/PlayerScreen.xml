<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen player, a port of NativePlayerActivity. Two modes:
    - game:    `event` (+ `base`) - resolves the stream page's servers, plays HLS, Left/Right switch server
    - channel: `channelGroup` + `channelIndex` - plays IPTV channels, Left/Right zap within the group

  Chrome (all measurements are Android dp x 2):
    - hudTop:    gradient scrim, [pill] [title] row, then the score line
    - hudBottom: gradient scrim, "Server n of m · name" line, then the key hints
    - status:    centred spinner + message + pill buttons (loading, errors, premium gate)
-->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="resumed" type="boolean" alwaysNotify="true" onChange="onResumed" />
    <field id="start" type="boolean" alwaysNotify="true" onChange="onStart" />
    <field id="devKey" type="string" alwaysNotify="true" onChange="onDevKey" />
    <field id="event" type="assocarray" />
    <field id="base" type="string" />
    <field id="channelGroup" type="assocarray" />
    <field id="channelIndex" type="integer" value="-1" />
    <!-- true once this screen took the shared premium pool slot; the scene releases it on pop -->
    <field id="holdsLease" type="boolean" value="false" />
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/SiteParser.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Site.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Resolver.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Account.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Iptv.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Pool.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Ui.brs" />
  <children>
    <Rectangle id="black" width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" enableTrickPlay="false" />

    <!-- HUD: both halves fade together -->
    <Group id="hud">
      <Group id="hudTop">
        <Poster id="topScrim" uri="pkg:/images/ui/scrim_top.png" loadDisplayMode="scaleToFill" width="1920" height="200" />
        <Poster id="hudPillBg" uri="pkg:/images/ui/pill_live.9.png" />
        <Label id="hudPill" horizAlign="center" vertAlign="center" />
        <Label id="hudTitle" vertAlign="center" />
        <Label id="hudScore" />
      </Group>
      <Group id="hudBottom">
        <Poster id="bottomScrim" uri="pkg:/images/ui/scrim_bottom.png" loadDisplayMode="scaleToFill" width="1920" height="220" />
        <Label id="hudServer" />
        <Group id="hudHint">
          <Poster id="hintLeft" uri="pkg:/images/ui/tri_l.png" />
          <Poster id="hintRight" uri="pkg:/images/ui/tri_r.png" />
          <Label id="hudHintText" />
        </Group>
      </Group>
      <Animation id="hudAnim" duration="0.18" easeFunction="linear">
        <FloatFieldInterpolator id="hudInterp" key="[0, 1]" fieldToInterp="hud.opacity" />
      </Animation>
    </Group>

    <!-- centre status: spinner + message + buttons -->
    <Group id="status" visible="false">
      <BusySpinner id="spinner" spinInterval="1.2" />
      <Label id="statusText" horizAlign="center" wrap="true" />
      <Group id="statusButtons" />
    </Group>

    <Timer id="hudTimer" duration="3.5" />
    <Timer id="retryTimer" duration="1.5" />
    <Timer id="scoreTimer" repeat="true" duration="30" />
    <Timer id="layoutTimer" duration="0.05" />
  </children>
</component>
