<?xml version="1.0" encoding="utf-8"?>
<!-- Window background while the home activity starts: same colour as the UI, so no flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item
        android:width="240dp"
        android:height="72dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/wordmark" />
    </item>
</layer-list>
