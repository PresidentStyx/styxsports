<?xml version="1.0" encoding="utf-8"?>
<!-- Sport filter chip: focused = white fill, selected = white outline, otherwise charcoal. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/outline_strong" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
