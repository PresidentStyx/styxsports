{
  "_about": "Design tokens for every Styx Sports client. Edit this file only; `node design/build.mjs` regenerates web/public/tokens.css, app/src/main/res/values/tokens.xml and roku/source/Tokens.brs (CI fails when they are stale). Sizes are 1080p TV pixels: the web uses them 1:1 on a desktop/TV browser, Roku FHD 1:1, Android TV at 1080p is xhdpi so dp = px / 2 (the generator divides). Phones scale in CSS.",

  "color": {
    "bg": "#0A0A0A",
    "surface": "#171717",
    "surfaceFocused": "#242424",
    "surfaceRaised": "#1F1F1F",
    "outline": "#262626",
    "outlineStrong": "#343434",
    "text": "#F5F5F5",
    "textSecondary": "#DDDDDD",
    "muted": "#9E9E9E",
    "accent": "#FFFFFF",
    "live": "#DC2626",
    "pre": "#2E2E2E",
    "final": "#3A3A3A",
    "halftime": "#B45309",
    "delayed": "#6B7280",
    "hot": "#FB923C",
    "gold": "#F5B942",
    "ok": "#22C55E",
    "warn": "#F59E0B",
    "error": "#EF4444",
    "premium": "#F5B942",
    "focusRing": "#FFFFFF",
    "scrim": "#000000B0",
    "heroScrim": "#0A0A0AE6",
    "black": "#000000"
  },

  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48, "gutter": 64 },

  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 24, "pill": 999 },

  "type": {
    "_note": "Sizes in 1080p px. Android emits sp (so the system font scale still applies; Android 14 scales non-linearly, large sizes grow less than small ones, which is the intent). Roku has no font scaling; its FHD sizes equal these numbers.",
    "display": { "size": 56, "weight": 800, "lineHeight": 1.05, "tracking": -0.02 },
    "title": { "size": 36, "weight": 700, "lineHeight": 1.15, "tracking": -0.01 },
    "heading": { "size": 28, "weight": 700, "lineHeight": 1.2, "tracking": 0 },
    "body": { "size": 24, "weight": 500, "lineHeight": 1.3, "tracking": 0 },
    "caption": { "size": 20, "weight": 600, "lineHeight": 1.3, "tracking": 0.01 },
    "micro": { "size": 16, "weight": 600, "lineHeight": 1.3, "tracking": 0.04 },
    "score": { "size": 44, "weight": 800, "lineHeight": 1.0, "tracking": -0.02 }
  },

  "motion": {
    "_note": "Milliseconds. `fast` for focus, `base` for state changes, `slow` for panels, `hero` for the Home hero crossfade.",
    "fast": 120, "base": 200, "slow": 320, "hero": 600,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },

  "focus": { "ringWidth": 3, "ringOffset": 2, "scale": 1.06 },

  "card": { "width": 250, "height": 150, "heroHeight": 420 },

  "aliases": {
    "_note": "Names the clients already use, kept so this file becomes their source of truth without a visual change.",
    "web": {
      "--bg": "color.bg", "--surface": "color.surface", "--surface-focused": "color.surfaceFocused",
      "--outline": "color.outline", "--outline-strong": "color.outlineStrong", "--text": "color.text",
      "--muted": "color.muted", "--live": "color.live", "--pill-time": "color.pre", "--hot": "color.hot",
      "--gold": "color.gold", "--card-w": "card.width", "--card-h": "card.height"
    },
    "android": {
      "bg": "color.bg", "surface": "color.surface", "surface_focused": "color.surfaceFocused",
      "outline": "color.outline", "outline_strong": "color.outlineStrong", "accent": "color.accent",
      "text": "color.text", "muted": "color.muted", "live": "color.live", "pill_time": "color.pre",
      "hot": "color.hot", "gold": "color.gold"
    },
    "roku": {
      "bg": "color.bg", "card": "color.surface", "surface": "color.surface", "pill": "color.surface",
      "cardFocus": "color.surfaceFocused", "surfaceFocused": "color.surfaceFocused",
      "line": "color.outline", "outline": "color.outline", "outlineStrong": "color.outlineStrong",
      "text": "color.text", "dim": "color.muted", "muted": "color.muted", "live": "color.live",
      "pillTime": "color.pre", "hot": "color.hot", "gold": "color.gold", "accent": "color.accent",
      "pillOn": "color.accent", "scrim": "color.scrim"
    }
  }
}
